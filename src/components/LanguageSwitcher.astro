---
import { getLanguageFromURL, getAlternateLocalePath } from '~/i18n/utils';

const currentPath = Astro.url.pathname;
const currentLang = getLanguageFromURL(currentPath);
const alternatePath = getAlternateLocalePath(currentPath, currentLang === 'zh' ? 'en' : 'zh');
---

<div class="flex items-center gap-1">
  <a
    href={currentLang === 'zh' ? Astro.url.pathname : alternatePath}
    class:list={[
      'px-2 py-1 text-sm rounded transition-colors',
      currentLang === 'zh'
        ? 'bg-blue-600 text-white'
        : 'text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400',
    ]}
  >
    中文
  </a>
  <span class="text-gray-400 dark:text-gray-600">|</span>
  <a
    href={currentLang === 'en' ? Astro.url.pathname : alternatePath}
    class:list={[
      'px-2 py-1 text-sm rounded transition-colors',
      currentLang === 'en'
        ? 'bg-blue-600 text-white'
        : 'text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400',
    ]}
  >
    English
  </a>
</div>
