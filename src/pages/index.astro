---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

// Video from public folder
const heroVideoUrl = "/assets/videos/ac4e42915f3905919be7879894e9930d.mp4";

const metadata = {
  title: 'AIOS - 面向企业的AI解决方案平台',
  ignoreTitleTemplate: true,
  description: 'AIOS是专注于为企业提供全方位AI解决方案的平台。基于MoFA企业级智能体框架，提供从AI战略咨询、解决方案设计、到系统部署和运维的全流程服务。',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero actions={[
      {
        variant: 'primary',
        text: '咨询AI方案',
        href: '/contact',
        target: '_self',
        icon: 'tabler:headset',
      },
      {
        variant: 'secondary',
        text: '了解服务',
        href: '/services',
        target: '_self',
        icon: 'tabler:info-circle',
      },
    ]} image={null}>
    <Fragment slot="title">
      <span class="text-accent dark:text-white">AIOS - 面向企业的AI解决方案平台</span>
    </Fragment>

    <Fragment slot="subtitle">
      基于MoFA企业级框架，提供从咨询到部署的全流程AI服务。智能驱动，业务增长。
    </Fragment>

    <Fragment slot="video">
      <video
        id="hero-video"
        class="mx-auto rounded-md w-full aspect-video shadow-2xl bg-black"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        controls
      >
        <source src={heroVideoUrl} type="video/mp4" />
        您的浏览器不支持视频播放。
      </video>

      <script is:inline>
        // Simple autoplay guarantee
        const video = document.getElementById('hero-video');
        if (video) {
          video.muted = true;

          // Try to play immediately
          video.play().catch(() => {
            // Fallback on user interaction
            const play = () => {
              video.play();
              document.removeEventListener('click', play);
            };
            document.addEventListener('click', play);
          });
        }
      </script>
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note
    title="AIOS的核心优势"
    description="AIOS采用Open Core模式，基于开源MoFA框架为企业提供专业AI解决方案服务。从战略咨询到系统部署，全程陪伴企业AI转型。"
  />

  <!-- Content Widget **************** -->

  <Content
    id="professional-services"
    tagline="专业服务"
    title="从战略到执行，全程陪伴"
    image={{
      src: '~/assets/images/agentos/enterprise.png',
      alt: 'AIOS Professional Services',
    }}
  >
    <Fragment slot="content">
      <ul class="space-y-2 mt-4">
        <li><strong>AI战略咨询：</strong>深入评估企业AI成熟度，识别高价值应用场景，制定切实可行的AI转型路线图</li>
        <li><strong>定制化解决方案：</strong>基于MoFA企业级框架，快速构建符合企业业务需求的AI智能体系统</li>
        <li><strong>端到端交付：</strong>从需求分析、方案设计、系统开发到部署上线的全流程交付服务</li>
        <li><strong>持续优化服务：</strong>提供7x24监控、故障响应和持续优化，确保AI系统稳定运行并持续创造价值</li>
      </ul>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    id="technical-foundation"
    isReversed
    tagline="技术基石"
    title="基于MoFA企业级框架"
    image={{
      src: '~/assets/images/agentos/bwmdN12Ic2t.png',
      alt: 'MoFA Core Architecture',
    }}
  >
    <Fragment slot="content">
      <ul class="space-y-2 mt-4">
        <li><strong>模块化架构：</strong>像搭积木一样构建智能体，极大提升开发效率和系统可维护性</li>
        <li><strong>数据流驱动：</strong>采用灵活的数据流模式，智能体之间松耦合，可以动态重组、拆解和复用</li>
        <li><strong>企业级特性：</strong>支持高可用部署、身份认证、数据加密、访问控制等企业级安全特性</li>
        <li><strong>多模型支持：</strong>兼容OpenAI、Qwen等多种主流AI模型，保障技术自主权和选择灵活性</li>
      </ul>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    id="competitive-advantage"
    tagline="差异化优势"
    title="为什么选择AIOS？"
    image={{
      src: '~/assets/images/agentos/change.png',
      alt: 'AIOS Competitive Advantage',
    }}
  >
    <Fragment slot="content">
      <div class="text-2xl font-bold mb-2">AIOS与传统AI服务商的核心差异</div>

      <div class="mt-4 grid md:grid-cols-2 gap-4">
        <div>
          <div class="font-semibold text-red-600 mb-1">传统AI服务商</div>
          <div class="text-sm">提供标准化工具或单一咨询服务，缺乏技术框架支撑，难以快速落地和持续优化</div>
        </div>
        <div>
          <div class="font-semibold text-blue-600 mb-1">AIOS解决方案平台</div>
          <div class="text-sm">基于MoFA企业级框架，提供从咨询到部署的一站式服务，快速交付、持续优化、全程可控</div>
        </div>
      </div>
    </Fragment>
  </Content>

  <!-- Features Widget *************** -->

  <Features
    tagline="全方位服务体系"
    title="AIOS六大专业服务"
    items={[
      {
        title: 'AI战略咨询',
        description: 'AI成熟度评估、场景识别、ROI评估、转型路径规划',
        icon: 'tabler:brain',
      },
      {
        title: '解决方案设计',
        description: '系统架构设计、模型选型、数据方案设计、风险评估',
        icon: 'tabler:schema',
      },
      {
        title: '智能体系统开发',
        description: '基于MoFA框架快速构建和部署定制化AI智能体系统',
        icon: 'tabler:robot',
      },
      {
        title: '数据工程服务',
        description: '数据清洗、标注、质量管理、数据管道构建',
        icon: 'tabler:database',
      },
      {
        title: '模型优化服务',
        description: 'Prompt工程、模型微调、RAG构建、性能调优',
        icon: 'tabler:adjustments',
      },
      {
        title: '运维支持服务',
        description: '7x24监控、故障响应、系统优化、持续迭代',
        icon: 'tabler:headset',
      },
    ]}
  />

  <!-- Steps Widget ******************* -->

  <Steps
    tagline="合作流程"
    title="与AIOS合作的简单流程"
    items={[
      {
        title: '需求诊断',
        description: '深入了解企业业务需求和AI应用场景，评估可行性和预期收益',
      },
      {
        title: '方案设计',
        description: '基于MoFA框架设计定制化AI解决方案，明确技术路径和交付计划',
      },
      {
        title: '快速交付',
        description: '采用敏捷开发模式，快速构建、部署和优化AI智能体系统',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '咨询AI方案',
        href: '/contact',
        target: '_self',
        icon: 'tabler:headset',
      },
      {
        variant: 'secondary',
        text: '了解服务详情',
        href: '/services',
        target: '_self',
        icon: 'tabler:info-circle',
      },
    ]}
  >
    <Fragment slot="title">
      <span class="sm:whitespace-nowrap">开启您的AI转型之旅</span>
    </Fragment>

    <Fragment slot="subtitle">
      AIOS专业团队随时准备为您提供AI战略咨询和解决方案设计服务!
    </Fragment>
  </CallToAction>
</Layout>
