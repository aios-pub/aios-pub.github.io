---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

// Video from public folder
const heroVideoUrl = "/assets/videos/ac4e42915f3905919be7879894e9930d.mp4";

const metadata = {
  title: 'MoFA - Modular Framework for Agents',
  ignoreTitleTemplate: true,
  description: '开源的模块化智能体开发框架，让开发者和企业快速构建、部署和管理下一代AI应用。',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero actions={[]} image={null}>
    <Fragment slot="title">
      <span class="text-accent dark:text-white">MoFA - Modular Framework for Agents</span>
    </Fragment>

    <Fragment slot="subtitle">
      开源的、模块化的、可组合的AI智能体开发框架，让普通人做非凡事。
    </Fragment>

    <Fragment slot="video">
      <video
        id="hero-video"
        class="mx-auto rounded-md w-full aspect-video shadow-2xl bg-black"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        controls
      >
        <source src={heroVideoUrl} type="video/mp4" />
        您的浏览器不支持视频播放。
      </video>

      <script is:inline>
        // Simple autoplay guarantee
        const video = document.getElementById('hero-video');
        if (video) {
          video.muted = true;

          // Try to play immediately
          video.play().catch(() => {
            // Fallback on user interaction
            const play = () => {
              video.play();
              document.removeEventListener('click', play);
            };
            document.addEventListener('click', play);
          });
        }
      </script>
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note
    title="让智能体开发更简单"
    description="MoFA 创新性的“数据流驱动”和“组合式AI”架构，解决了当前智能体开发技术门槛高、系统难以维护、组件复用性差等痛点。"
  />

  <!-- Content Widget **************** -->

  <Content
    id="architecture"
    isReversed
    tagline="核心架构"
    title="数据流驱动的组合式AI架构"
    image={{
      src: '~/assets/images/agentos/bwmdN12Ic2t.png',
      alt: 'MoFA Core Architecture',
    }}
  >
    <Fragment slot="content">
      <ul class="space-y-2 mt-4">
        <li>**模块化与可组合性**：像搭积木一样构建智能体，极大提升开发效率和系统可维护性</li>
        <li>**数据流驱动**：采用灵活的数据流模式，智能体之间松耦合，可以动态重组、拆解和复用</li>
        <li>**跨平台兼容**：支持多模型（OpenAI，Qwen等）、多操作系统，保障技术自主权和选择灵活性</li>
      </ul>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    id="core-shifts"
    tagline="核心优势"
    title="为什么选择 MoFA 构建智能体？"
    image={{
      src: '~/assets/images/agentos/change.png',
      alt: 'MoFA Core Advantages',
    }}
  >
    <Fragment slot="content">
      <div class="text-2xl font-bold mb-2">MoFA 与传统框架的核心差异</div>

      <div class="mt-4 grid md:grid-cols-2 gap-4">
        <div>
          <div class="font-semibold text-blue-600 mb-1">传统AI应用框架</div>
          <div class="text-sm">强调工具链集成，缺乏智能体层面的抽象和组合能力</div>
        </div>
        <div>
          <div class="font-semibold text-blue-600 mb-1">MoFA 框架</div>
          <div class="text-sm">专注智能体层面的抽象和组合，数据流驱动架构更适合构建复杂、多步骤的自治系统</div>
        </div>
      </div>
    </Fragment>
  </Content>

  <!-- Features Widget *************** -->

  <Features
    tagline="核心特性"
    title="MoFA 的强大功能"
    items={[
      {
        title: '真正的模块化与可组合性',
        description: '像搭积木一样构建智能体，极大提升开发效率和系统可维护性',
        icon: 'tabler:blocks',
      },
      {
        title: '开发者友好',
        description: '全栈 Python 支持，并兼容 Rust 高性能扩展，拥有强大的开发者生态潜力',
        icon: 'tabler:code',
      },
      {
        title: '开源核心',
        description: '采用开源策略快速建立社区、积累用户并形成生态标准',
        icon: 'tabler:git-branch',
      },
      {
        title: '可视化工具 MoFA Stage',
        description: '提供从可视化编排、调试到管理的端到端图形化工具，降低使用门槛，吸引非专业开发者',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: '多模型与跨平台兼容',
        description: '支持多模型（OpenAI，Qwen等）、多操作系统，保障用户的技术自主权和选择灵活性',
        icon: 'tabler:device-laptop',
      },
    ]}
  />

  <!-- Steps Widget ******************* -->

  <Steps
    tagline="快速开始"
    title="使用 MoFA 构建智能体只需三步"
    items={[
      {
        title: '选择模块化组件',
        description: '从丰富的预构建模块化组件库中选择所需功能',
      },
      {
        title: '可视化编排或代码开发',
        description: '通过 MoFA Stage 可视化编排或直接用 Python/Rust 代码开发智能体',
      },
      {
        title: '部署与管理',
        description: '一键部署智能体，实现监控、扩缩容等全生命周期管理',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '查看 GitHub',
        href: 'https://github.com/mofa-org/mofa',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
    ]}
  >
    <Fragment slot="title">
      <span class="sm:whitespace-nowrap">开始构建您的智能体</span>
    </Fragment>

    <Fragment slot="subtitle">
      立即体验 MoFA 模块化智能体开发框架!
    </Fragment>
  </CallToAction>
</Layout>
