---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

// Video from public folder
const heroVideoUrl = "/assets/videos/ac4e42915f3905919be7879894e9930d.mp4";

const metadata = {
  title: 'Enterprise Modular Agent Framework',
  ignoreTitleTemplate: true,
  description: '开源的模块化智能体开发框架，提供企业级SaaS和本地部署解决方案，满足不同规模企业的AI开发需求。',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero actions={[
      {
        variant: 'primary',
        text: '查看商业方案',
        href: '/pricing',
        target: '_self',
        icon: 'tabler:credit-card',
      },
      {
        variant: 'secondary',
        text: '开源版本',
        href: 'https://github.com/mofa-org/mofa',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
    ]} image={null}>
    <Fragment slot="title">
      <span class="text-accent dark:text-white">Enterprise Modular Agent Framework</span>
    </Fragment>

    <Fragment slot="subtitle">
      开源的模块化智能体开发框架，提供企业级SaaS托管和本地部署解决方案，助力企业快速构建、部署和管理下一代AI应用。
    </Fragment>

    <Fragment slot="video">
      <video
        id="hero-video"
        class="mx-auto rounded-md w-full aspect-video shadow-2xl bg-black"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        controls
      >
        <source src={heroVideoUrl} type="video/mp4" />
        您的浏览器不支持视频播放。
      </video>

      <script is:inline>
        // Simple autoplay guarantee
        const video = document.getElementById('hero-video');
        if (video) {
          video.muted = true;

          // Try to play immediately
          video.play().catch(() => {
            // Fallback on user interaction
            const play = () => {
              video.play();
              document.removeEventListener('click', play);
            };
            document.addEventListener('click', play);
          });
        }
      </script>
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note
    title="企业级智能体开发解决方案"
    description="MoFA 采用 Open Core 模式，开源核心提供基础能力，商业版本提供企业级功能，满足从初创公司到大型企业的不同需求。"
  />

  <!-- Content Widget **************** -->

  <Content
    id="enterprise-solutions"
    tagline="商业版本优势"
    title="为什么企业选择 MoFA 商业解决方案？"
    image={{
      src: '~/assets/images/agentos/enterprise.png',
      alt: 'MoFA Enterprise Solutions',
    }}
  >
    <Fragment slot="content">
      <ul class="space-y-2 mt-4">
        <li>高可用性与稳定性：SaaS 版本提供 99.9%  uptime 保障，企业版支持本地部署和高可用配置</li>
        <li>高级安全管控：企业级身份认证、数据加密、访问控制，保障数据安全</li>
        <li>专业技术支持：24/7 技术支持、专属客户经理、定制化培训服务</li>
        <li>性能分析与监控：实时监控智能体运行状态，提供详细的性能分析报告</li>
        <li>定制化开发：根据企业需求提供定制化功能开发和集成服务</li>
      </ul>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    id="architecture"
    isReversed
    tagline="核心架构"
    title="数据流驱动的组合式AI架构"
    image={{
      src: '~/assets/images/agentos/bwmdN12Ic2t.png',
      alt: 'MoFA Core Architecture',
    }}
  >
    <Fragment slot="content">
      <ul class="space-y-2 mt-4">
        <li>模块化与可组合性：像搭积木一样构建智能体，极大提升开发效率和系统可维护性</li>
        <li>数据流驱动：采用灵活的数据流模式，智能体之间松耦合，可以动态重组、拆解和复用</li>
        <li>跨平台兼容：支持多模型（OpenAI，Qwen等）、多操作系统，保障技术自主权和选择灵活性</li>
      </ul>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    id="core-shifts"
    tagline="核心优势"
    title="为什么选择 MoFA 构建智能体？"
    image={{
      src: '~/assets/images/agentos/change.png',
      alt: 'MoFA Core Advantages',
    }}
  >
    <Fragment slot="content">
      <div class="text-2xl font-bold mb-2">MoFA 与传统框架的核心差异</div>

      <div class="mt-4 grid md:grid-cols-2 gap-4">
        <div>
          <div class="font-semibold text-blue-600 mb-1">传统AI应用框架</div>
          <div class="text-sm">强调工具链集成，缺乏智能体层面的抽象和组合能力</div>
        </div>
        <div>
          <div class="font-semibold text-blue-600 mb-1">MoFA 框架</div>
          <div class="text-sm">专注智能体层面的抽象和组合，数据流驱动架构更适合构建复杂、多步骤的自治系统</div>
        </div>
      </div>
    </Fragment>
  </Content>

  <!-- Features Widget *************** -->

  <Features
    tagline="全栈特性"
    title="MoFA 开源与商业版本的核心功能"
    items={[
      {
        title: '真正的模块化与可组合性',
        description: '像搭积木一样构建智能体，极大提升开发效率和系统可维护性',
        icon: 'tabler:blocks',
      },
      {
        title: '开发者友好',
        description: '全栈 Python 支持，并兼容 Rust 高性能扩展，拥有强大的开发者生态潜力',
        icon: 'tabler:code',
      },
      {
        title: '可视化工具 MoFA Stage',
        description: '提供从可视化编排、调试到管理的端到端图形化工具，降低使用门槛',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: '企业级安全',
        description: '商业版本提供身份认证、数据加密、访问控制等高级安全特性',
        icon: 'tabler:shield-lock',
      },
      {
        title: '专业技术支持',
        description: '商业版本提供 24/7 技术支持和专属客户经理服务',
        icon: 'tabler:headset',
      },
      {
        title: '灵活部署选项',
        description: '支持 SaaS 托管、本地部署和混合云部署',
        icon: 'tabler:server',
      },
    ]}
  />

  <!-- Steps Widget ******************* -->

  <Steps
    tagline="快速开始"
    title="使用 MoFA 构建智能体只需三步"
    items={[
      {
        title: '选择模块化组件',
        description: '从丰富的预构建模块化组件库中选择所需功能',
      },
      {
        title: '可视化编排或代码开发',
        description: '通过 MoFA Stage 可视化编排或直接用 Python/Rust 代码开发智能体',
      },
      {
        title: '部署与管理',
        description: '一键部署智能体，实现监控、扩缩容等全生命周期管理',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '立即咨询商业方案',
        href: '/contact',
        target: '_self',
        icon: 'tabler:credit-card',
      },
      {
        variant: 'secondary',
        text: '免费试用开源版本',
        href: 'https://github.com/mofa-org/mofa',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
    ]}
  >
    <Fragment slot="title">
      <span class="sm:whitespace-nowrap">选择适合您的 MoFA 方案</span>
    </Fragment>

    <Fragment slot="subtitle">
      无论是开源探索还是企业级应用，MoFA 都能满足您的需求!
    </Fragment>
  </CallToAction>
</Layout>
