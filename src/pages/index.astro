---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'aios.pub - 探索AI无限可能',
  ignoreTitleTemplate: true,
  description: 'AIOS是您的AI探索伙伴——汇聚前沿AI项目、核心技术洞察、创新编程方法论与深度评测。提供从战略咨询到系统部署的全栈AI解决方案。',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero actions={[
      {
        variant: 'primary',
        text: '开启AI之旅',
        href: '/projects',
        target: '_self',
        icon: 'tabler:rocket',
      },
      {
        variant: 'secondary',
        text: '企业解决方案',
        href: '/services',
        target: '_self',
        icon: 'tabler:building',
      },
    ]} image={null}>
    <Fragment slot="title">
      <span class="text-accent dark:text-white">AIOS</span><br />
      <span class="text-2xl md:text-3xl">探索AI的无限可能</span>
    </Fragment>

    <Fragment slot="subtitle">
      您的AI探索伙伴——汇聚前沿项目、核心技术洞察、创新编程方法论与深度评测。<br class="hidden md:block" />
      提供从战略咨询到系统部署的全栈AI解决方案，助力企业智能化转型。
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note
    title="为什么选择 AIOS？"
    description="在AI快速发展的时代，AIOS致力于成为您最值得信赖的AI伙伴。无论是探索前沿技术、获取专业洞察，还是构建企业级AI系统，我们都能为您提供全方位支持。"
  />

  <!-- Features Widget *************** -->

  <Features
    tagline="AI 生态全景"
    title="一站式AI探索与服务"
    items={[
      {
        title: '前沿项目',
        description: '汇聚精心打造的AI项目，从智能体到自动化工具，探索AI技术的无限边界',
        icon: 'tabler:rocket',
        link: '/projects',
      },
      {
        title: '技术洞察',
        description: '深度解析AI核心技术，从Prompt工程到模型微调，掌握AI开发精髓',
        icon: 'tabler:bulb',
        link: '/skills',
      },
      {
        title: 'VibeCoding',
        description: '创新编程方法论——用直觉和创造力编写代码，释放AI时代的编程艺术',
        icon: 'tabler:code',
        link: '/vibecoding',
      },
      {
        title: '深度评测',
        description: '专业客观的AI工具与模型评测，助您在众多选择中找到最优解',
        icon: 'tabler:chart-bar',
        link: '/reviews',
      },
      {
        title: '企业解决方案',
        description: '全栈AI解决方案，从战略咨询到系统部署，助力企业智能化转型',
        icon: 'tabler:building',
        link: '/services',
      },
      {
        title: '技术社区',
        description: '加入AI开发者社区，与全球技术爱好者共同探索AI技术的未来',
        icon: 'tabler:users',
        href: '#',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    id="about-platform"
    tagline="关于 AIOS"
    title="不只是内容平台，更是AI生态引擎"
    image={{
      src: 'https://images.unsplash.com/photo-1677442136019-21780ecad995?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'AIOS Platform',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg mb-4 font-medium">AIOS 是一个综合性的AI平台，涵盖内容、技术与服务的完整生态：</p>
      <ul class="space-y-3 mt-4">
        <li class="flex items-start gap-2">
          <span class="text-blue-500 mt-1">▸</span>
          <span><strong class="text-gray-900 dark:text-white">知识引擎：</strong>前沿项目展示、技术深度解析、创新方法论分享</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-blue-500 mt-1">▸</span>
          <span><strong class="text-gray-900 dark:text-white">决策引擎：</strong>专业AI工具评测，为您的技术选型提供可靠依据</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-blue-500 mt-1">▸</span>
          <span><strong class="text-gray-900 dark:text-white">创新引擎：</strong>VibeCoding方法论，用直觉与创造力重新定义编程</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-blue-500 mt-1">▸</span>
          <span><strong class="text-gray-900 dark:text-white">服务引擎：</strong>全栈AI解决方案，从战略咨询到系统落地全程护航</span>
        </li>
      </ul>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    id="technical-foundation"
    isReversed
    tagline="技术实力"
    title="全栈AI技术能力"
    image={{
      src: 'https://images.unsplash.com/photo-1555949963-aa79dcee981c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'AI Technology Stack',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg mb-4 font-medium">深厚的技术积累，支撑您的AI之旅：</p>
      <ul class="space-y-3 mt-4">
        <li class="flex items-start gap-2">
          <span class="text-green-500 mt-1">✓</span>
          <span><strong>智能体开发</strong>——模块化架构设计，快速构建复杂AI系统</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-green-500 mt-1">✓</span>
          <span><strong>多模型集成</strong>——OpenAI、Claude、Qwen等主流模型无缝对接</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-green-500 mt-1">✓</span>
          <span><strong>企业级保障</strong>——高可用部署、安全认证、合规审计一应俱全</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-green-500 mt-1">✓</span>
          <span><strong>全栈能力</strong>——从数据处理到模型部署，端到端技术覆盖</span>
        </li>
      </ul>
    </Fragment>
  </Content>

  <!-- Steps Widget ******************* -->

  <Steps
    tagline="探索之旅"
    title="如何开启您的AI之旅？"
    items={[
      {
        title: '探索发现',
        description: '浏览前沿项目、技术洞察和深度评测，了解AI的最新动态和核心趋势',
        icon: 'tabler:compass',
      },
      {
        title: '深度学习',
        description: '掌握Prompt工程、模型微调、智能体开发等核心技能，成为AI开发者',
        icon: 'tabler:school',
      },
      {
        title: '实践创新',
        description: '运用VibeCoding方法论，将创意转化为现实，构建属于您的AI应用',
        icon: 'tabler:rocket',
      },
      {
        title: '企业赋能',
        description: '需要专业支持？我们的团队为您提供从战略到落地的全栈AI服务',
        icon: 'tabler:building',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '探索AI世界',
        href: '/projects',
        target: '_self',
        icon: 'tabler:rocket',
      },
      {
        variant: 'secondary',
        text: '获取企业方案',
        href: '/services',
        target: '_self',
        icon: 'tabler:headset',
      },
    ]}
  >
    <Fragment slot="title">
      <span class="sm:whitespace-nowrap">AI时代，从这里启航</span>
    </Fragment>

    <Fragment slot="subtitle">
      无论您是AI探索者还是企业决策者，AIOS都是您值得信赖的伙伴。<br class="hidden md:block" />
      让我们一起，探索AI的无限可能！
    </Fragment>
  </CallToAction>
</Layout>
