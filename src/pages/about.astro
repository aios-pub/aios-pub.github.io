---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '关于我们',
  description: '了解AIOS - 您的AI探索伙伴，提供全栈AI解决方案',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="关于我们"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'AIOS Team',
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">智能驱动，共创未来</span><br />
      AIOS - 您的AI探索伙伴
    </Fragment>

    <Fragment slot="subtitle">
      AIOS是一个综合性的AI平台，汇聚前沿项目、核心技术洞察、创新编程方法论与深度评测。我们致力于为开发者和企业提供从战略咨询到系统部署的全栈AI解决方案。
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="平台数据"
    stats={[
      { title: '服务客户', amount: '50+' },
      { title: '成功项目', amount: '100+' },
      { title: '行业覆盖', amount: '10+' },
      { title: '技术专家', amount: '30+' },
    ]}
  />

  <!-- Features3 Widget: 核心价值 -->

  <Features3
    title="我们的使命"
    subtitle="让每一个企业和开发者都能轻松拥抱AI，释放数据价值，驱动业务增长"
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'AI民主化',
        description: '降低AI应用门槛，让更多企业和开发者享受到AI技术带来的价值',
        icon: 'tabler:rocket',
      },
      {
        title: '价值创造',
        description: '专注于解决真实业务问题，以ROI为导向，确保AI投入带来可衡量的业务价值',
        icon: 'tabler:trending-up',
      },
      {
        title: '长期陪伴',
        description: '不只是交付项目，更是长期合作伙伴。从咨询到部署，再到持续优化，全程陪伴',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- Features3 Widget: 核心优势 -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: '技术领先',
        description: '拥有全栈AI技术能力，从数据处理到模型部署，端到端技术覆盖',
        icon: 'tabler:brand-codesandbox',
      },
      {
        title: '行业经验',
        description: '深耕金融、制造、零售、医疗等多个行业，积累了丰富的AI落地经验',
        icon: 'tabler:briefcase',
      },
      {
        title: '专业团队',
        description: '由AI领域资深专家组成，具备深厚的学术背景和丰富的实践经验',
        icon: 'tabler:users',
      },
      {
        title: '敏捷交付',
        description: '采用敏捷开发方法论，快速迭代，持续交付，确保项目按时保质完成',
        icon: 'tabler:bolt',
      },
      {
        title: '客户成功',
        description: '以客户成功为导向，不仅交付系统，更确保客户能够使用好、维护好AI系统',
        icon: 'tabler:trophy',
      },
      {
        title: '持续创新',
        description: '紧跟AI技术发展前沿，持续将最新技术应用到产品和服务中',
        icon: 'tabler:bulb',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'AIOS Innovation',
    }}
  />

  <!-- Steps2 Widget: 我们的价值观 -->

  <Steps2
    title="我们的价值观"
    subtitle="这些价值观指导我们的每一个决策和行动"
    items={[
      {
        title: '客户第一',
        description:
          '客户成功是我们成功的唯一标准。我们始终将客户利益放在首位，以客户需求为导向，提供超出预期的服务。',
      },
      {
        title: '技术为本',
        description:
          '技术是我们的立身之本。我们持续投入技术研发，保持技术领先优势，为客户提供最先进的AI解决方案。',
      },
      {
        title: '开放协作',
        description:
          '拥抱开源，相信开放协作的力量。我们积极参与技术社区，与开发者共同推动AI技术进步。',
      },
    ]}
  />

  <!-- Features2 Widget: 联系我们 -->

  <Features2
    title="联系我们"
    tagline="开启AI转型之旅"
    columns={3}
    items={[
      {
        title: '商务咨询',
        description: '了解AIOS服务，获取定制化AI解决方案',
        icon: 'tabler:mail',
      },
      {
        title: '技术交流',
        description: '加入开发者社区，与技术爱好者交流',
        icon: 'tabler:messages',
      },
      {
        title: '加入我们',
        description: 'AIOS正在寻找志同道合的AI技术人才',
        icon: 'tabler:user-plus',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="准备好开始您的AI项目了吗？"
    subtitle="AIOS专业团队随时准备为您提供AI咨询服务，量身定制最适合的AI解决方案"
    actions={[
      {
        variant: 'primary',
        text: '咨询服务',
        href: '/contact',
        icon: 'tabler:headset',
      },
      {
        variant: 'secondary',
        text: '了解服务',
        href: '/services',
        icon: 'tabler:info-circle',
      },
    ]}
  />
</Layout>
