---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '定价方案',
  description: 'AIOS提供灵活的AI服务定价方案：AI咨询服务、解决方案交付和企业年度服务',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="定价方案"
    title="AIOS专业AI服务定价"
    subtitle="灵活透明的定价方案，满足企业不同阶段的AI需求"
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="服务方案"
    subtitle="AIOS提供按项目交付和年度订阅等多种服务方式，根据企业实际需求灵活配置"
    prices={[
      {
        title: 'AI咨询服务',
        subtitle: '按项目报价',
        price: '定制',
        period: 'per project',
        items: [
          {
            description: 'AI成熟度评估',
          },
          {
            description: '应用场景识别',
          },
          {
            description: 'ROI评估分析',
          },
          {
            description: 'AI转型路线图',
          },
          {
            description: '专家顾问支持',
          },
        ],
        callToAction: {
          target: '_self',
          text: '咨询服务',
          href: '/contact',
        },
      },
      {
        title: '解决方案交付',
        subtitle: '按项目报价',
        price: '定制',
        period: 'per project',
        items: [
          {
            description: '定制化解决方案设计',
          },
          {
            description: '智能体系统开发',
          },
          {
            description: '数据工程服务',
          },
          {
            description: '模型优化服务',
          },
          {
            description: '部署与培训',
          },
          {
            description: '一定期限的技术支持',
          },
        ],
        callToAction: {
          target: '_self',
          text: '了解详情',
          href: '/contact',
        },
        hasRibbon: true,
        ribbonTitle: '推荐',
      },
      {
        title: '企业年度服务',
        subtitle: '按年订阅',
        price: '定制',
        period: 'per year',
        items: [
          {
            description: '专属技术团队',
          },
          {
            description: '7x24运维支持',
          },
          {
            description: '系统持续优化',
          },
          {
            description: '新功能优先体验',
          },
          {
            description: 'SLA服务保障',
          },
          {
            description: '定期技术回顾',
          },
        ],
        callToAction: {
          target: '_self',
          text: '联系销售',
          href: '/contact',
        },
      },
    ]}
  />

  <!-- Steps Widget: 服务流程 ****************** -->

  <Steps
    title="AIOS服务流程"
    tagline="从需求到交付"
    items={[
      {
        title: '需求沟通',
        icon: 'tabler:number-1',
        description: '深入了解企业业务需求和AI应用目标',
      },
      {
        title: '方案设计',
        icon: 'tabler:number-2',
        description: '设计定制化AI解决方案和实施计划',
      },
      {
        title: '报价评估',
        icon: 'tabler:number-3',
        description: '根据项目复杂度和资源需求提供报价',
      },
      {
        title: '合同签署',
        icon: 'tabler:number-4',
        description: '明确服务范围、交付标准和时间表',
      },
      {
        title: '实施交付',
        icon: 'tabler:number-5',
        description: '按计划实施项目，快速交付成果',
      },
      {
        title: '持续支持',
        icon: 'tabler:number-6',
        description: '提供运维支持，持续优化改进',
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="定价常见问题"
    subtitle="关于AIOS定价的常见问题解答"
    columns={1}
    items={[
      {
        title: 'AI咨询服务如何收费？',
        description:
          'AI咨询服务按项目收费，我们会根据评估范围、工作量和交付要求提供定制化报价。通常包括AI成熟度评估、场景识别、ROI分析和转型路线图设计。',
      },
      {
        title: '解决方案交付服务的定价依据是什么？',
        description:
          '解决方案交付按项目定价，主要考虑以下因素：系统复杂度、开发工作量、数据工程需求、模型优化范围、部署方式等。我们会在需求评估后提供详细的报价方案。',
      },
      {
        title: '企业年度服务包含哪些内容？',
        description:
          '企业年度服务包括专属技术团队、7x24运维支持、系统持续优化、新功能优先体验、SLA服务保障和定期技术回顾等。适合需要长期AI服务支持的企业客户。',
      },
      {
        title: '可以先试用服务再正式合作吗？',
        description:
          '当然可以！我们可以先进行小规模的概念验证（POC），让您体验我们的技术能力和服务质量。确认满意后再进行正式合作。',
      },
      {
        title: '支付方式有哪些？',
        description:
          '我们支持多种支付方式，包括银行转账、在线支付等。对于大额项目，可以分阶段付款。具体支付方式可以在合同洽谈时确定。',
      },
      {
        title: '如果对服务不满意可以退款吗？',
        description:
          '我们重视客户满意度。如果在服务过程中遇到问题，我们会第一时间沟通解决。对于按项目交付的服务，我们会在合同中明确里程碑和验收标准，确保双方权益。',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="获取定制化报价"
    subtitle="联系AIOS专业团队，获取最适合您企业需求的AI解决方案报价"
    actions={[
      {
        variant: 'primary',
        text: '咨询服务',
        href: '/contact',
        icon: 'tabler:headset',
      },
      {
        variant: 'secondary',
        text: '了解服务',
        href: '/services',
        icon: 'tabler:info-circle',
      },
    ]}
  />
</Layout>
