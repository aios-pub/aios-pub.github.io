---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '企业AI解决方案',
  description: 'AIOS提供全方位企业AI解决方案：AI战略咨询、智能体系统开发、数据工程、模型优化和运维支持，助力企业数字化转型',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="企业AI解决方案"
    title="赋能企业，智领未来"
    subtitle="从战略规划到系统落地，AIOS为企业提供全生命周期的AI解决方案。全栈技术能力，快速交付、稳定可靠、持续进化。"
    actions={[{ variant: 'primary', target: '_self', text: '预约咨询', href: '/contact', icon: 'tabler:headset' }]}
    image={null}
  />

  <!-- Features Widget ************** -->

  <Features
    tagline="全栈AI服务"
    title="从愿景到现实，全程陪伴"
    items={[
      {
        title: 'AI战略咨询',
        description: '深度评估企业AI成熟度，识别高价值场景，制定可落地的AI转型路线图',
        icon: 'tabler:brain',
        link: '/contact',
      },
      {
        title: '解决方案设计',
        description: '设计可扩展的AI架构，精准选型模型，制定完整数据方案与风险评估',
        icon: 'tabler:schema',
        link: '/contact',
      },
      {
        title: '智能体系统开发',
        description: '模块化快速构建企业级AI智能体，支持多模型、多云、多场景部署',
        icon: 'tabler:robot',
        link: '/contact',
      },
      {
        title: '数据工程服务',
        description: '从数据采集到质量管理，构建高质量数据管道，夯实AI基础',
        icon: 'tabler:database',
        link: '/contact',
      },
      {
        title: '模型优化服务',
        description: 'Prompt工程、模型微调、RAG构建、性能调优，榨取AI最大价值',
        icon: 'tabler:adjustments',
        link: '/contact',
      },
      {
        title: '运维支持服务',
        description: '7x24监控、快速响应、持续迭代，保障AI系统稳定高效运行',
        icon: 'tabler:headset',
        link: '/contact',
      },
    ]}
  />

  <!-- Content Widget: AI战略咨询 -->

  <Content
    id="ai-consulting"
    tagline="战略先行"
    title="AI战略咨询服务"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'AI战略咨询',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg font-medium mb-4">帮您找到AI价值的最佳切入点</p>
      <ul class="space-y-3">
        <li class="flex items-start gap-2">
          <span class="text-blue-500 mt-1">▸</span>
          <span><strong>AI成熟度评估：</strong>全面诊断企业AI现状，识别差距与机会</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-blue-500 mt-1">▸</span>
          <span><strong>场景价值分析：</strong>精准定位高ROI的AI应用场景</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-blue-500 mt-1">▸</span>
          <span><strong>转型路线规划：</strong>制定分阶段、可落地的AI转型路径</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-blue-500 mt-1">▸</span>
          <span><strong>ROI预测分析：</strong>量化投资回报，支持决策</span>
        </li>
      </ul>
    </Fragment>
  </Content>

  <!-- Content Widget: 智能体系统开发 -->

  <Content
    id="agent-development"
    isReversed
    tagline="核心能力"
    title="智能体系统开发"
    image={{
      src: 'https://images.unsplash.com/photo-1485827404703-89b55fcc595e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: '智能体系统开发',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg font-medium mb-4">全栈技术能力，快速构建企业级AI智能体</p>
      <ul class="space-y-3">
        <li class="flex items-start gap-2">
          <span class="text-green-500 mt-1">✓</span>
          <span><strong>模块化架构：</strong>像搭积木一样构建复杂AI系统</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-green-500 mt-1">✓</span>
          <span><strong>多模型兼容：</strong>OpenAI、Claude、Qwen等主流模型无缝切换</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-green-500 mt-1">✓</span>
          <span><strong>灵活部署：</strong>云端SaaS、私有化部署、混合云任选</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-green-500 mt-1">✓</span>
          <span><strong>无缝集成：</strong>与企业现有系统快速对接</span>
        </li>
      </ul>
    </Fragment>
  </Content>

  <!-- Features2 Widget: 行业解决方案 -->

  <Features2
    title="行业解决方案"
    tagline="深耕行业"
    subtitle="为各行各业量身定制AI解决方案"
    columns={3}
    items={[
      {
        title: '金融科技',
        description: '智能投顾、风险评估、智能客服、反欺诈等金融AI方案',
        icon: 'tabler:coin',
      },
      {
        title: '智能制造',
        description: '预测性维护、质量检测、供应链优化、智能排产',
        icon: 'tabler:building-factory',
      },
      {
        title: '零售电商',
        description: '智能推荐、需求预测、智能客服、库存优化',
        icon: 'tabler:shopping-cart',
      },
      {
        title: '医疗健康',
        description: '辅助诊断、智能问诊、药物研发、健康管理',
        icon: 'tabler:heartbeat',
      },
      {
        title: '教育培训',
        description: '智能辅导、个性化学习、自动批改、智能答疑',
        icon: 'tabler:school',
      },
      {
        title: '更多行业',
        description: '联系我们，获取您所在行业的定制化方案',
        icon: 'tabler:dots',
      },
    ]}
  />

  <!-- Steps Widget: 服务流程 -->

  <Steps
    title="服务流程"
    tagline="专业高效"
    items={[
      {
        title: '需求洞察',
        description: '深入了解业务痛点和AI应用目标',
      },
      {
        title: '方案定制',
        description: '设计针对性的AI解决方案和实施计划',
      },
      {
        title: '快速交付',
        description: '敏捷开发，快速迭代，按时保质交付',
      },
      {
        title: '培训赋能',
        description: '提供全面培训，确保团队熟练使用',
      },
      {
        title: '持续进化',
        description: '运维支持，持续优化，共同成长',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '预约咨询',
        href: '/contact',
        icon: 'tabler:headset',
      },
      {
        variant: 'secondary',
        text: '查看定价',
        href: '/pricing',
        icon: 'tabler:credit-card',
      },
    ]}
    title="准备好开启AI转型了吗？"
    subtitle="AIOS专业团队随时待命，为您量身定制最适合的AI解决方案"
  />
</Layout>
