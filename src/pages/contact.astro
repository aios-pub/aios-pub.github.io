---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import wechatOfficialAccountImage from '~/assets/images/we_chat_official_account.jpg';
import wechatImage from '~/assets/images/wechat.jpg';
import discordImage from '~/assets/images/discord.jpg';

const metadata = {
  title: '联系我们',
  description: '联系AIOS专业团队，获取AI咨询服务和解决方案',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="联系我们" title="开启AI转型之旅" subtitle="AIOS专业团队随时准备为您提供AI咨询服务" />

  <!-- Features2 Widget: 服务分类 -->

  <Features2
    title="服务咨询"
    subtitle="根据您的需求选择相应的服务类型"
    columns={2}
    items={[
      {
        title: '商务咨询',
        description: '了解AIOS服务方案、获取报价、商务合作等商务相关咨询，我们会安排专属客户经理与您联系。',
        icon: 'tabler:briefcase',
      },
      {
        title: '技术咨询',
        description: 'AI解决方案设计咨询、系统架构讨论、技术选型等技术相关咨询，我们的技术专家将为您解答。',
        icon: 'tabler:code',
      },
      {
        title: '合作咨询',
        description: '技术合作伙伴、行业解决方案合作、渠道代理等合作咨询，共同拓展AI服务市场。',
        icon: 'tabler:users',
      },
      {
        title: '媒体联系',
        description: '媒体采访、新闻报道、演讲邀请等媒体相关事宜，请联系我们的公关团队。',
        icon: 'tabler:news',
      },
    ]}
  />

  <!-- Features2 Widget: 联系方式 -->

  <Features2
    title="联系方式"
    subtitle="多种方式与我们取得联系"
    columns={4}
    items={[
      {
        title: '电子邮箱',
        description: 'contact@aios.pub',
        icon: 'tabler:mail',
      },
      {
        title: '商务热线',
        description: '400-xxx-xxxx',
        icon: 'tabler:phone',
      },
      {
        title: '开发者社区',
        description: '加入AI开发者社区',
        icon: 'tabler:brand-github',
      },
      {
        title: '工作时间',
        description: '周一至周五 9:00-18:00',
        icon: 'tabler:clock',
      },
    ]}
  />

  <!-- 联系方式二维码 -->
  <section class="mx-auto mt-16 max-w-5xl px-4 sm:mt-24 sm:px-6">
    <div class="text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50 sm:text-4xl">
        联系我们
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
        扫描二维码添加好友或加入社区
      </p>
      <div class="mx-auto mt-8 grid gap-8 sm:grid-cols-3 max-w-4xl">
        <div class="flex flex-col items-center">
          <h3 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">
            微信公众号
          </h3>
          <img
            src={wechatOfficialAccountImage.src}
            alt="微信公众号：架构师部落"
            class="h-56 w-56 rounded-lg object-cover shadow-lg"
          />
          <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
            架构师部落<br/>深度技术文章、架构设计分享
          </p>
        </div>
        <div class="flex flex-col items-center">
          <h3 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">
            微信号
          </h3>
          <img
            src={wechatImage.src}
            alt="微信号"
            class="h-56 w-56 rounded-lg object-cover shadow-lg"
          />
          <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
            添加好友<br/>一对一咨询服务
          </p>
        </div>
        <div class="flex flex-col items-center">
          <h3 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">
            Discord
          </h3>
          <img
            src={discordImage.src}
            alt="Discord"
            class="h-56 w-56 rounded-lg object-cover shadow-lg"
          />
          <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
            加入社区<br/>全球开发者交流
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="还可以通过这些方式了解我们"
    subtitle="探索AIOS的更多资源"
    actions={[
      {
        variant: 'secondary',
        text: '了解服务',
        href: '/services',
        icon: 'tabler:info-circle',
      },
      {
        variant: 'secondary',
        text: '查看定价',
        href: '/pricing',
        icon: 'tabler:credit-card',
      },
      {
        variant: 'secondary',
        text: '关于我们',
        href: '/about',
        icon: 'tabler:users',
      },
      {
        variant: 'primary',
        text: '探索项目',
        href: '/projects',
        icon: 'tabler:rocket',
      },
    ]}
  />
</Layout>
